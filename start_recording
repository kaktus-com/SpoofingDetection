#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
if [[ "$(basename -- "$(dirname -- "$SCRIPT_DIR")")" == releases ]]; then
  PROJECT_DIR="$(dirname -- "$(dirname -- "$SCRIPT_DIR")")"
fi
cd "$SCRIPT_DIR"
CAPTURE_PYTHON="${CAPTURE_PYTHON:-python3}"
if [[ "$CAPTURE_PYTHON" == python3 ]]; then
  for candidate in "$SCRIPT_DIR/../venv/bin/python" "$SCRIPT_DIR/../../../venv/bin/python"; do
    if [[ -x "$candidate" ]]; then CAPTURE_PYTHON="$candidate"; break; fi
  done
fi
exec "$CAPTURE_PYTHON" -m detect2.acquisition.runtime --output-root "$PROJECT_DIR/recordings_v2" "$@"
